# ─────────────────────────────────────────────────────────────
# RentalTruth — Elastic Cloud Configuration
# ─────────────────────────────────────────────────────────────

# ── Elasticsearch (Elastic Cloud GCP) ────────────────────────
ES_HOST=truth-teller-afba06.es.us-central1.gcp.elastic.cloud
ES_PORT=443
ES_SCHEME=https

# API Key authentication (base64-encoded id:secret)
ES_API_KEY=your_base64_encoded_api_key

# Username/password not used — API key takes priority
ES_USERNAME=
ES_PASSWORD=

# ── Index ────────────────────────────────────────────────────
ES_INDEX_PROPERTIES=bangalore_properties
ES_INDEX_REPLICA=1
ES_INDEX_SHARDS=1

# ── ELSER ────────────────────────────────────────────────────
# Elastic Cloud already has ML enabled — use the built-in endpoint
ELSER_INFERENCE_ID=.elser-2-elasticsearch
ELSER_NUM_ALLOCATIONS=1
ELSER_NUM_THREADS=1

# ── Crawler Settings ─────────────────────────────────────────
CRAWL_DELAY_SECONDS=2
CRAWL_CONCURRENT_REQUESTS=8
CRAWL_CONCURRENT_REQUESTS_PER_DOMAIN=2
CRAWL_DOWNLOAD_TIMEOUT=30
CRAWL_MAX_RETRIES=3

# ── Target Areas ─────────────────────────────────────────────
BANGALORE_AREAS=Whitefield,Koramangala
TRANSACTION_TYPE=both

# ── Scheduler ────────────────────────────────────────────────
CRAWL_SCHEDULE_CRON=0 6 * * *

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── AWS Bedrock Credentials ──────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── LLM Configuration ────────────────────────────────────────
# Options: gemini | bedrock | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest


