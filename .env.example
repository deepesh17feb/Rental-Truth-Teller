# ─────────────────────────────────────────────────────────────
# RentalTruth – Tier 0 Crawler Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Elasticsearch ─────────────────────────────────────────────
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_INDEX_PROPERTIES=bangalore_properties
ES_INDEX_REPLICA=0
ES_INDEX_SHARDS=1

# ── Crawler Settings ─────────────────────────────────────────
CRAWL_DELAY_SECONDS=2
CRAWL_CONCURRENT_REQUESTS=8
CRAWL_CONCURRENT_REQUESTS_PER_DOMAIN=2
CRAWL_DOWNLOAD_TIMEOUT=30
CRAWL_MAX_RETRIES=3

# ── Target Areas (comma-separated Bangalore localities) ───────
BANGALORE_AREAS=Whitefield,Koramangala

# ── Target Transaction Type ───────────────────────────────────
# Options: rent | sale | both
TRANSACTION_TYPE=both

# ── ELSER (Elastic Learned Sparse EncodeR) ───────────────────────────────
# Built-in endpoint (no manual model deployment needed with ES 8.13+)
ELSER_INFERENCE_ID=.elser-2-elasticsearch
# For a custom endpoint with explicit resource control, change to a name like:
#   ELSER_INFERENCE_ID=elser-bangalore-properties
# and run: python scripts/deploy_elser.py
ELSER_NUM_ALLOCATIONS=1
ELSER_NUM_THREADS=1

# ── Scheduler ────────────────────────────────────────────────
# Cron expression for automated crawl schedule
CRAWL_SCHEDULE_CRON=0 6 * * *

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── LLM Configuration ────────────────────────────────────────
# Options: gemini | bedrock | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# AWS Bedrock default fallbacks
AWS_DEFAULT_REGION=us-east-1

